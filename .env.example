# Telegram Bot Token — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key — used for voice transcription (Whisper)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key — used for message parsing (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets ID — the long ID string from your sheet's URL
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Path to Google service account credentials JSON
GOOGLE_CREDENTIALS_PATH=./config/google-credentials.json

# Telegram user IDs allowed to use this bot (comma-separated)
# Get your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Messaging platform: telegram | whatsapp | telegram+whatsapp | all
MESSAGING_PLATFORM=whatsapp

# Phone numbers for user identification (include country code, e.g. +12125551234)
PHONE_JEFF=
PHONE_PARTNER=

# Display names recorded in Google Sheets
NAME_JEFF=Jeff
NAME_PARTNER=Partner

# Express webhook server port
PORT=3000

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_JEFF=your_email@example.com
EMAIL_PARTNER=partner_email@example.com
