{
  "name": "project-tracker",
  "version": "1.0.0",
  "description": "Telegram-based project tracker with AI parsing and Google Sheets storage",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:dashboard": "cd src/dashboard && npm install && npm run build",
    "digest": "node -e \"require('dotenv').config(); require('./src/jobs/weekly-digest').runWeeklyDigest().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "node tests/test-messages.js",
    "test:sheets": "node tests/test-sheets.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "form-data": "^4.0.0",
    "googleapis": "^144.0.0",
    "node-cron": "^4.2.1",
    "openai": "^4.52.0",
    "resend": "^4.0.0",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
