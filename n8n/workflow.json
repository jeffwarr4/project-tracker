      ]
    },
    "Get Telegram File Info": {
      "main": [[{ "node": "Download Voice File", "type": "main", "index": 0 }]]
    },
    "Download Voice File": {
      "main": [[{ "node": "Transcribe with Whisper", "type": "main", "index": 0 }]]
    },
    "Transcribe with Whisper": {
      "main": [[{ "node": "Set Message Text (from voice branch)", "type": "main", "index": 0 }]]
    },
    "Set Message Text (from voice branch)": {
      "main": [[{ "node": "Get Existing Projects", "type": "main", "index": 0 }]]
    },
    "Extract Text (from text branch)": {
      "main": [[{ "node": "Get Existing Projects", "type": "main", "index": 0 }]]
    },
    "Get Existing Projects": {
      "main": [[{ "node": "Build AI Prompt", "type": "main", "index": 0 }]]
    },
    "Build AI Prompt": {
      "main": [[{ "node": "Parse with Claude AI", "type": "main", "index": 0 }]]
    },
    "Parse with Claude AI": {
      "main": [[{ "node": "Parse AI Response", "type": "main", "index": 0 }]]
    },
    "Parse AI Response": {
      "main": [[{ "node": "Route by Category", "type": "main", "index": 0 }]]
    },
    "Route by Category": {
      "main": [
        [{ "node": "Add New Project to Sheet", "type": "main", "index": 0 }],
        [{ "node": "Log Time to Sheet", "type": "main", "index": 0 }],
        [{ "node": "Log Time to Sheet", "type": "main", "index": 0 }],
        [{ "node": "Ask Clarification", "type": "main", "index": 0 }]
      ]
    },
    "Add New Project to Sheet": {
      "main": [[{ "node": "Send Telegram Reply", "type": "main", "index": 0 }]]
    },
    "Log Time to Sheet": {
      "main": [[{ "node": "Send Telegram Reply", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "project-tracker" }]
}
